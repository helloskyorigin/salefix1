# SaleFix server-only environment variables. Never commit real secrets.
# The public free audit in production requires a durable Upstash Redis store.
# Install Upstash Redis in the Vercel Marketplace, connect it to this project,
# and redeploy after setting the following variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Gemini AI. Consumer Gemini Plus does not include an API key.
# Calls are rate limited; file AI is off until explicitly enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SALEFIX_ENABLE_FILE_AI=false
SALEFIX_FILE_REVIEW_MODEL=gemini-3.5-flash-lite

# Dodo Payments: product must be a one-time USD $49 product.
# Checkout stays disabled unless EVERY server-side requirement is present,
# and SALEFIX_PAYMENTS_ENABLED=true. Test in test_mode before live.
SALEFIX_PAYMENTS_ENABLED=false
SALEFIX_PUBLIC_ORIGIN=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=

# Email sender must be verified by Resend. Passwordless links expire after 7 days.
RESEND_API_KEY=
SALEFIX_DELIVERY_FROM=

# Generate a random >=32-character server-only HMAC signing secret.
SALEFIX_KIT_SECRET=

# Merchant account age/identity/KYC and business acceptance must be approved.
# Do not enable real checkout without provider sandbox payment, webhook,
# access-email recovery, refund and hosted-page tests passing.
