# Optional: Enables AI-assisted copy improvement. Without this,
# the content audit still works using evidence-based page checks.
GEMINI_API_KEY=
# Optional server-side Gemini API key (consumer Gemini plans are not API keys).
GEMINI_MODEL=gemini-3.5-flash-lite
# Off by default to avoid unexpected API spend on an open audit endpoint.
# Enable only after adding durable rate limiting and monitoring.
SALEFIX_ENABLE_FILE_AI=false
SALEFIX_FILE_REVIEW_MODEL=gemini-3.5-flash-lite

# PAYMENT IS NOT ACTIVE IN THIS VERSION.
# Do not accept real payments until secure buyer verification,
# delivery and live-page publishing are implemented and tested.

# Configure only on the server, never commit the real value.
# Requires a 32+ character random secret. Checkout/webhook must verify payment first.
SALEFIX_KIT_SECRET=
